COMPOSE_PROJECT_NAME=ecommerce-pipeline

# Images
KAFKA_IMAGE=apache/kafka:3.9.0
SPARK_IMAGE=apache/spark:4.0.2-scala2.13-java17-ubuntu
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8-alpine
POSTGRES_IMAGE=postgres:16-alpine
AIRFLOW_BASE_IMAGE=apache/airflow:2.10.2-python3.11
SUPERSET_IMAGE=apache/superset:4.1.0

# Ports
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8090
CONNECT_REST_PORT=8083
SPARK_MASTER_WEB_PORT=8081
SPARK_DRIVER_WEB_PORT=4040
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
POSTGRES_PORT=5432
AIRFLOW_WEBSERVER_PORT=8080
SUPERSET_PORT=8088

# Kafka & Connect
KAFKA_CLUSTER_ID=change_me
KAFKA_TOPIC=ecommerce_events_stream
CONNECT_BOOTSTRAP_SERVERS=kafka:9092

# ClickHouse Core
CLICKHOUSE_DB=ecommerce
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me

# Superset read-only ClickHouse user
SUPERSET_CH_USER=superset_ro
SUPERSET_CH_PASSWORD=change_me

# PostgreSQL Metadata DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_JWT_SECRET=change_me
AIRFLOW_API_SECRET_KEY=change_me

# Superset
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me
SUPERSET_SECRET_KEY=change_me

# Spark Streaming & Ingestion Defaults (Tuned in Phase 10 & Phase 11)
SPARK_MODE=clean
SPARK_SINK=clickhouse
SPARK_TRIGGER_SECONDS=0
SPARK_MAX_OFFSETS_PER_TRIGGER=600000
CH_WRITE_BATCH_SIZE=600000
CH_REPARTITION_BY_PARTITION=true
KAFKA_MIN_PARTITIONS=4
CH_WRITE_FORMAT=json
SPARK_EXECUTOR_MEMORY=2g
SPARK_CORES_MAX=2AIRFLOW_DB=change_me
AIRFLOW_DB_USER=change_me
AIRFLOW_DB_PASSWORD=change_me
SUPERSET_DB=change_me
SUPERSET_DB_USER=change_me
SUPERSET_DB_PASSWORD=change_me
KAFKA_PARTITIONS=change_me
KAFKA_REPLICATION_FACTOR=change_me
SPARK_MASTER_UI_PORT=change_me
AIRFLOW_ADMIN_EMAIL=change_me
DATA_FILE_SAMPLE=change_me
DATA_FILE_FULL=change_me
KAFKA_UI_IMAGE=change_me
CONNECT_BASE_IMAGE=change_me
SPOOLDIR_VERSION=change_me
SPARK_MASTER_PORT=change_me
SPARK_WORKER_UI_PORT=change_me
SPARK_WORKER_MEMORY=change_me
SPARK_WORKER_CORES=change_me
SUPERSET_BASE_IMAGE=change_me
AIRFLOW_DB=change_me
