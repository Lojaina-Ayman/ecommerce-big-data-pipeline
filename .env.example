# =====================================================
# eCommerce Big Data Pipeline - environment template
# Copy this file to .env and adjust values.
# NOTE: image versions are added in Phase 3 after verification.
# =====================================================

COMPOSE_PROJECT_NAME=ecommerce-pipeline

# ---- PostgreSQL (metadata for Airflow + Superset) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow
SUPERSET_DB=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=change_me_superset

# ---- Kafka ----
KAFKA_TOPIC=ecommerce_events_stream
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8090

# ---- Spark ----
SPARK_MASTER_UI_PORT=8081

# ---- ClickHouse ----
CLICKHOUSE_DB=ecommerce
CLICKHOUSE_USER=default_admin
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ---- Airflow ----
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---- Superset ----
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me_admin
# Generate a long random value for this, see the command in Phase 1 notes
SUPERSET_SECRET_KEY=change_me_to_a_long_random_string

# ---- Data files ----
DATA_FILE_SAMPLE=data/sample/events_sample_100k.csv
DATA_FILE_FULL=data/raw/2019-Oct.csv
# ---- Image versions (verified in Phase 3) ----
KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:latest
CONNECT_BASE_IMAGE=confluentinc/cp-kafka-connect:8.3.2
SPOOLDIR_VERSION=2.0.65
SPARK_IMAGE=apache/spark:4.0.2-scala2.13-java17-ubuntu
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.3

# ---- Kafka cluster ID (22 chars, from kafka-storage.sh random-uuid) ----
KAFKA_CLUSTER_ID=PUT_GENERATED_ID_HERE

# ---- Extra ports ----
CONNECT_REST_PORT=8083
SPARK_MASTER_PORT=7077
SPARK_WORKER_UI_PORT=8082

# ---- Spark worker resources ----
SPARK_WORKER_MEMORY=3g
SPARK_WORKER_CORES=2

# ---- Airflow 3 Runtime Secrets ----
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=generate_with_airflow_image
AIRFLOW_JWT_SECRET=generate_base64_string
AIRFLOW_API_SECRET_KEY=generate_base64_string
